# CPU-only RapidOCR image. Build context: output of build-inputs.py.
FROM ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip curl ca-certificates libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# RapidOCR and supervision declare GUI OpenCV; only its headless provider is
# installed. pip check reports that upstream metadata mismatch explicitly.
ARG PIP_FIND_LINKS
ARG PIP_TRUSTED_HOST
COPY requirements-build.txt requirements-cpu.txt /build/
RUN python3 -m pip install --require-hashes --no-deps -r /build/requirements-build.txt \
    && python3 -m pip install --require-hashes --no-deps --no-build-isolation -r /build/requirements-cpu.txt

COPY wheels/ /build/wheels/
RUN python3 -m pip install --no-deps \
        /build/wheels/aap_task_contract-*.whl \
        /build/wheels/aap_protocol_v2-*.whl \
        /build/wheels/aap_lifecycle_contract-*.whl \
        /build/wheels/aap_backend_runtime-*.whl \
        /build/wheels/rapidocr_backend-*.whl \
    && rm -rf /build
ENV RAPIDOCR_MODEL_DIR=/var/lib/aap-plugin/models \
    RAPIDOCR_DEVICE=cpu
EXPOSE 8005
ENTRYPOINT ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8005", "--workers", "1"]
